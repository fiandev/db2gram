{
  "name": "db2gram",
  "version": "1.0.0",
  "description": "Automated multi-database backup to Telegram (dump -> zip -> encrypt -> chunk -> upload).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "db2gram": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "bash scripts/test-integration.sh"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "unzipper": "^0.12.3",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/unzipper": "^0.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
