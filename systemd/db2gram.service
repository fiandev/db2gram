[Unit]
Description=db2gram: dump, encrypt and upload databases to Telegram
Documentation=https://github.com/your-org/db2gram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=db2gram
Group=db2gram
WorkingDirectory=/opt/db2gram
# SECRET_KEY, ROOT_DATABASE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID live here.
# chmod 600 /etc/db2gram.env and chown root:db2gram.
EnvironmentFile=/etc/db2gram.env
ExecStart=/usr/bin/node /opt/db2gram/dist/cli.js backup --format json --out-manifest /var/lib/db2gram/manifest-latest.json
# Telegram uploads can take a while on large databases.
TimeoutStartSec=3600
