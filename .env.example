# Copy to .env and fill in. NEVER commit the filled file.
# Generate a key with: openssl rand -base64 32
SECRET_KEY=

# Control DB for backup_runs / backup_chunks (audit history). Not backed up itself.
# postgres://user:pass@host:5432/tgdb_state  OR  mysql://user:pass@host:3306/tgdb_state
ROOT_DATABASE_URL=

# Telegram bot credentials (create a bot with @BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- optional ---
# CONFIG_PATH=./config.yaml.enc
# CHUNK_SIZE_MB=48
# TMP_DIR=/tmp/tgdb
# LOG_LEVEL=info          # debug | info | warn | error | silent
# LOG_FORMAT=json         # omit for human-readable logs
# TGDB_SKIP_STATE=1       # disable audit logging (tests / one-off runs)
