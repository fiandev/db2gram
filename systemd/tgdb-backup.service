[Unit]
Description=tgdb-backup: dump, encrypt and upload databases to Telegram
Documentation=https://github.com/your-org/tgdb-backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tgdb
Group=tgdb
WorkingDirectory=/opt/tgdb-backup
# SECRET_KEY, ROOT_DATABASE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID live here.
# chmod 600 /etc/tgdb-backup.env and chown root:tgdb.
EnvironmentFile=/etc/tgdb-backup.env
ExecStart=/usr/bin/node /opt/tgdb-backup/dist/cli.js backup --format json --out-manifest /var/lib/tgdb-backup/manifest-latest.json
# Telegram uploads can take a while on large databases.
TimeoutStartSec=3600
